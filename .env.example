APP_NAME="Global Fishing Vessel Tracking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production URL: https://gfw.nagakecil.site

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Target Production Database: PostgreSQL with PostGIS
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gfvip_production
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Local Development Fallback (if PostgreSQL not yet configured)
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# --------------------------------------------------------------------------
# MARITIME INTELLIGENCE PROVIDER CONFIGURATION
# (Biarkan kosong untuk mempertahankan status "Not Configured" yang transparan)
# --------------------------------------------------------------------------

# Global Fishing Watch (GFW Events & Encounters API v3)
# Ketentuan: Riset non-komersial; pendaftaran via globalfishingwatch.org
GFW_API_TOKEN=
GFW_API_BASE_URL=https://gateway.api.globalfishingwatch.org/v3

# Copernicus Data Space Ecosystem (Sentinel-1 SAR Satellite Imagery)
# Pendaftaran & OAuth Client: dataspace.copernicus.eu
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1

# Live AIS Stream Provider
# WebSocket feed / API endpoint: aisstream.io atau provider komersial
AIS_STREAM_API_KEY=
AIS_STREAM_URL=wss://stream.aisstream.io/v0/stream

# Spatio-Temporal Encounter Detection Parameters
ENCOUNTER_MAX_DISTANCE_METERS=500
ENCOUNTER_MIN_DURATION_MINUTES=30
ENCOUNTER_TOLERANCE_MINUTES=10

# Google Single Sign-On (SSO OAuth 2.0)
# Production Redirect URI: https://gfw.nagakecil.site/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

VITE_APP_NAME="${APP_NAME}"
