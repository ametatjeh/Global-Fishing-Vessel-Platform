# -----------------------------------------------------------------------------
# GFVIP - Systemd Unit File for AIS Live Stream Service
# Path on Linux: /etc/systemd/system/ais-stream.service
# Enable: sudo systemctl enable --now ais-stream.service
# Logs:   sudo journalctl -u ais-stream.service -f
# -----------------------------------------------------------------------------

[Unit]
Description=GFVIP Live AIS WebSocket Telemetry Consumer Service
After=network.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/global-fishing-vessel-intelligence
ExecStart=/usr/bin/php /var/www/global-fishing-vessel-intelligence/artisan ais:listen --daemon --timeout=30 --max-reconnects=50
Restart=always
RestartSec=10s
StandardOutput=append:/var/www/global-fishing-vessel-intelligence/storage/logs/ais-stream-service.log
StandardError=append:/var/www/global-fishing-vessel-intelligence/storage/logs/ais-stream-service.error.log
TimeoutStopSec=30s
KillMode=process

[Install]
WantedBy=multi-user.target
