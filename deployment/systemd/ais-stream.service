# -----------------------------------------------------------------------------
# GFVIP - Systemd Unit File for AIS Live Stream Service
# Path on Linux/aaPanel: /etc/systemd/system/ais-stream.service
# Enable: sudo systemctl daemon-reload && sudo systemctl enable --now ais-stream.service
# Logs:   sudo journalctl -u ais-stream.service -f
# Note:   User & group default pada aaPanel adalah www:www.
#         Verifikasi user PHP-FPM dengan: ps aux | grep php-fpm
# -----------------------------------------------------------------------------

[Unit]
Description=GFVIP Live AIS WebSocket Telemetry Consumer Service
After=network.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/gfw.nagakecil.site
ExecStart=/usr/bin/php /www/wwwroot/gfw.nagakecil.site/artisan ais:listen --daemon --timeout=30 --max-reconnects=50
Restart=always
RestartSec=10s
StandardOutput=append:/www/wwwroot/gfw.nagakecil.site/storage/logs/ais-stream.log
StandardError=append:/www/wwwroot/gfw.nagakecil.site/storage/logs/ais-stream-error.log
TimeoutStopSec=30s
KillMode=process

[Install]
WantedBy=multi-user.target
