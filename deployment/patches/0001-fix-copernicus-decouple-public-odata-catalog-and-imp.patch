+        Config::set('maritime.providers.copernicus_sar.password', 'SecretPassword123!');
+        Config::set('maritime.providers.copernicus_sar.totp', null);
+        Config::set('maritime.providers.copernicus_sar.auth_url', $this->authUrl);
