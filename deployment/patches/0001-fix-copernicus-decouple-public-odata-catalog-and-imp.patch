+            'category' => $category,
+            'description' => $description,
+            'duration_ms' => $durationMs,
+            'timestamp' => now()->toIso8601String(),
+        ];
+
+        Log::warning("[Copernicus CDSE Auth] Failure [{$category}]: {$description} (Duration: {$durationMs}ms, HTTP: {$httpStatus})");
     }
 
